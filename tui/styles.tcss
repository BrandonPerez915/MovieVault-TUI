/* MovieVault Textual Stylesheet (backend/tui/styles.tcss) */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Floating Toasts */
ToastRack {
    margin: 1 2;
}

Toast {
    background: #161b22;
    color: #e6edf3;
    border-left: thick #58a6ff;
    padding: 1 2;
}

Toast.-error {
    background: #1c1215;
    border-left: thick #f85149;
}

Toast.-warning {
    background: #1e1912;
    border-left: thick #f0883e;
}

Toast.-information {
    background: #bbf7d0;
    color: #052e16;
    border-left: thick #16a34a;
}

/* Header & Status Bar */
#top-bar {
    dock: top;
    height: 3;
    margin-top: 1;
    background: #161b22;
    border-top: solid #161b22;
    border-bottom: solid #30363d;
    padding: 0 2;
    content-align: left middle;
    align: left middle;
}

#top-bar-brand {
    width: auto;
    height: 1;
    content-align: left middle;
}

#top-bar-spacer {
    width: 1fr;
    height: 1;
}

#btn-user-menu {
    width: auto;
    min-width: 12;
    height: 1;
    border: none;
    background: #21262d;
    color: #79c0ff;
    padding: 0 2;
}

#btn-user-menu:hover, #btn-user-menu:focus {
    background: #30363d;
    color: #ffffff;
}

UserMenuModal {
    align: right top;
    padding: 4 2 0 0;
    background: rgba(0, 0, 0, 0.35);
}

#user-menu-card {
    width: 34;
    height: auto;
    background: #161b22;
    border: round #58a6ff;
    padding: 1 1;
}

#user-menu-header {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: left middle;
    border-bottom: solid #30363d;
    margin-bottom: 1;
    padding-bottom: 1;
}

#user-menu-title {
    width: 1fr;
    padding: 0 1;
}

#btn-close-user-menu {
    width: 5;
    min-width: 5;
    height: 1;
    border: none;
    background: transparent;
    color: #8b949e;
    padding: 0;
}

#btn-close-user-menu:hover {
    color: #f0f6fc;
    background: #30363d;
}

.user-menu-item {
    width: 100%;
    height: 3;
    margin-bottom: 0;
    content-align: left middle;
}

/* Auth Screen */
AuthScreen {
    align: center middle;
}

#auth-card {
    width: 88;
    height: auto;
    max-height: 40;
    background: #161b22;
    border: round #58a6ff;
    padding: 1 3;
}

#auth-title {
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

.figlet-header {
    width: 100%;
    height: auto;
    border-bottom: dashed #30363d;
    padding-bottom: 1;
    margin-bottom: 1;
}

#auth-feedback {
    height: 2;
    text-align: center;
    color: #f0883e;
}

.auth-input {
    margin-bottom: 1;
}

#auth-buttons {
    height: 3;
    align: center middle;
    margin-top: 1;
}

#auth-buttons Button {
    margin: 0 1;
}

#demo-users-box {
    margin-top: 1;
    border-top: dashed #30363d;
    padding-top: 1;
    height: auto;
}

/* Modals (UserSwitchModal, ReviewMovieModal, ManageListModal, SocialActionModal, HelpScreen, etc.) */
UserSwitchModal, ReviewMovieModal, ManageListModal, SocialActionModal, HelpScreen, WrappedModal, EditProfileModal, UploadAvatarModal, FollowListModal, CreateListModal, VisitProfileModal, SearchReviewsModal, ConfirmModal, AddMovieToListModal {
    align: center middle;
}

.modal-card {
    width: 84;
    height: auto;
    max-height: 38;
    background: #161b22;
    border: double #58a6ff;
    padding: 1 2;
}

#help-card {
    width: 88;
    border: double #58a6ff;
}

#switch-card {
    width: 72;
    height: 24;
    border: double #d2a8ff;
}

#review-modal-card {
    border: double #3fb950;
}

#rev-content-area {
    height: 5;
    border: round #30363d;
    margin-bottom: 1;
}

#list-modal-card {
    border: double #58a6ff;
}

#social-modal-card {
    border: double #d2a8ff;
}

.modal-feedback {
    height: 2;
    color: #f85149;
}

.modal-row {
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.modal-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.modal-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}

/* StateMessage */
StateMessage {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    background: #161b22;
    border: round #30363d;
}

StateMessage.empty-state {
    padding: 2 4;
    content-align: center middle;
    text-align: center;
    border: round #f0883e;
}

LoadingSpinner.loading-state,
StateMessage.loading-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    padding: 2 4;
    margin: 0;
    background: transparent;
    border: none;
}

.modal-feedback.loading-state {
    width: 100%;
    height: auto;
    padding: 0;
    margin-bottom: 1;
    content-align: center middle;
    text-align: center;
}

/* MovieCard & MovieGrid (Letterboxd Poster Grid) */
MovieGrid {
    height: 1fr;
}

.movie-grid-scroll {
    height: 1fr;
    padding: 0 1;
}

.movie-grid-container {
    height: auto;
    padding: 0 1;
}

.movie-grid-inner {
    layout: grid;
    grid-size: 4;
    grid-gutter: 1 2;
    height: auto;
    padding: 1 0;
}

.movie-card {
    width: 22;
    height: 16;
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    align: center top;
}

.movie-card-removable {
    height: 18;
}

.movie-card-remove-btn {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    margin-top: 0;
}

.movie-card:focus {
    border: double #58a6ff;
    background: #1f2937;
}

.card-poster {
    width: 18;
    height: 11;
    content-align: center middle;
}

.card-caption {
    width: 1fr;
    height: 3;
    text-align: center;
}

.pagination-bar {
    height: 3;
    background: #161b22;
    border-top: solid #30363d;
    padding: 0 2;
    align: center middle;
}

.page-btn {
    margin: 0 2;
}

.page-info {
    width: auto;
    content-align: center middle;
}

/* User HomeScreen & Tabs */
#user-tabs {
    height: 1fr;
    margin-top: 1;
}

#user-tabs Tabs {
    width: 100%;
}

#user-tabs #tabs-list {
    width: 100%;
}

#user-tabs Tab {
    width: 1fr;
    content-align: center middle;
}

#home-hero-header {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
    background: #161b22;
    border: round #30363d;
}

#home-ascii-banner {
    width: 100%;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

#home-search-row {
    width: 100%;
    height: 3;
    layout: horizontal;
    align: center middle;
}

#home-quick-search-input {
    width: 1fr;
    margin-right: 1;
}

.tab-page-container {
    height: 1fr;
    padding: 1 2;
}

.tab-page-scroll {
    height: 1fr;
    padding: 1 2;
    align: center top;
}

.section-toolbar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.section-toolbar Button {
    margin-left: 1;
}

#tab-explore {
    height: 1fr;
}

#explore-container {
    width: 86;
    height: auto;
}

#explore-selector-bar {
    width: 100%;
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#explore-selector-bar Label {
    width: auto;
    height: 3;
    content-align: left middle;
    margin: 0 1 0 0;
    padding: 0;
    text-style: bold;
    color: #79c0ff;
}

#explore-section-select {
    width: 1fr;
}

.query-form-card,
#search-form-card,
#diary-form-card,
#rec-form-card {
    width: 86;
    height: auto;
    background: #161b22;
    border: round #58a6ff;
    padding: 1 3;
}

#search-dynamic-fields,
#diary-dynamic-fields,
#rec-dynamic-fields {
    height: auto;
}

.form-title {
    margin-bottom: 1;
}

.form-description {
    margin-bottom: 2;
}

.form-mode-select {
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    color: #79c0ff;
    text-style: bold;
}

.query-field-input,
.search-field-input {
    margin-bottom: 1;
}

.form-submit-row {
    height: 3;
    margin-top: 1;
    align: right middle;
}

.filter-card {
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

.inline-fields-row {
    height: auto;
    layout: horizontal;
}

.inline-field-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.inline-field-col-last {
    margin-right: 0;
}

#diary-table, #rec-table, #query-results-table {
    height: 1fr;
}

#wrapped-figlet-header {
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

#wrapped-content-box {
    width: 100%;
    height: auto;
}

.wrapped-summary-card {
    background: #161b22;
    border: double #d2a8ff;
    padding: 1 3;
    height: auto;
    margin-bottom: 1;
}

.wrapped-section-card {
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 3;
    margin-bottom: 1;
}

.wrapped-section-title {
    margin-bottom: 1;
}

.wrapped-explanation {
    margin-bottom: 1;
}

.wrapped-cards-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
}

/* MovieDetailScreen, PersonScreen & ReviewsScreen */
.detail-page-scroll, .detail-page-container {
    height: 1fr;
    padding: 1 2;
}

.detail-top-actions {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.detail-top-actions Button {
    margin-right: 1;
}

.detail-section-actions {
    width: 100%;
    height: 3;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
    margin-bottom: 1;
}

.detail-section-actions Button {
    width: auto;
    margin: 0 1;
}

#movie-hero-box {
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

#movie-hero-content {
    width: 100%;
    height: auto;
    layout: horizontal;
}

#movie-hero-actions {
    margin-bottom: 0;
}

#person-hero-box {
    height: auto;
    layout: horizontal;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

#detail-poster {
    width: 28;
    height: 18;
    margin-right: 2;
}

#person-photo {
    width: 24;
    height: 16;
    margin-right: 2;
}

#movie-meta-box, #person-meta-box {
    width: 1fr;
    height: auto;
}

#person-movies-grid {
    height: auto;
}

#person-movies-grid .movie-grid-container,
#person-movies-grid .movie-grid-scroll {
    height: auto;
    overflow-y: hidden;
}

#person-movies-grid .movie-grid-inner {
    height: auto;
}

.carousel-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

.carousel-nav-btn {
    width: 5;
    min-width: 5;
    height: 16;
    margin: 0 1;
    content-align: center middle;
    text-style: bold;
}

.review-carousel-nav-btn {
    height: 9;
}

.chips-bar {
    width: 1fr;
    height: auto;
    layout: horizontal;
    align: center middle;
    padding: 0;
}

.reviews-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: left top;
    margin-bottom: 1;
}

.carousel-spacer {
    width: 1fr;
    height: 1;
}

.carousel-empty-slot {
    width: 22;
    height: 1;
}

.carousel-review-empty-slot {
    width: 42;
    height: 1;
}

.person-chip-btn {
    margin-right: 0;
}

.person-card {
    margin-right: 0;
}

#detail-reviews-preview {
    width: 1fr;
    height: auto;
    align: left top;
}

#home-genres-container {
    width: 100%;
    height: auto;
    margin-bottom: 2;
}

.reviews-filter-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.reviews-filter-bar Input {
    width: 36;
    margin: 0 1;
}

#rev-cards-scroll {
    height: 1fr;
}

.review-item-card {
    width: 42;
    max-width: 42;
    min-height: 9;
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-right: 0;
}

.list-item-card {
    width: 1fr;
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

.review-item-body {
    margin: 1 0;
}

/* AdminScreen Grid */
#dashboard-body {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 38;
    height: 1fr;
    background: #161b22;
    border-right: solid #30363d;
    padding: 1 1;
}

#sidebar-shortcuts {
    margin-top: 1;
    border-top: dashed #30363d;
    padding-top: 1;
    height: auto;
}

.panel-heading {
    text-style: bold;
    color: #79c0ff;
    margin-bottom: 1;
}

#admin-modules-list {
    height: 1fr;
    border: round #30363d;
    background: #0d1117;
}

#admin-modules-list:focus {
    border: round #58a6ff;
}

#main-workspace {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#queries-box {
    height: 10;
    border: round #30363d;
    background: #161b22;
    padding: 0 1;
    margin-bottom: 1;
}

#admin-queries-list {
    height: 1fr;
    background: #161b22;
}

#admin-queries-list:focus {
    border: solid #58a6ff;
}

#params-box {
    height: auto;
    min-height: 5;
    border: round #30363d;
    background: #161b22;
    padding: 0 1;
    margin-bottom: 1;
    layout: horizontal;
    align: left middle;
}

.param-input {
    width: 1fr;
    min-width: 16;
    margin-right: 1;
}

#btn-admin-execute {
    margin-left: 1;
}

#results-box {
    height: 1fr;
    border: round #30363d;
    background: #0d1117;
    padding: 0 1;
}

#admin-results-table {
    height: 1fr;
}

#admin-results-table:focus {
    border: solid #3fb950;
}

/* Technical Inspector Panel (AdminScreen) */
#inspector-panel {
    height: 11;
    border: round #d2a8ff;
    background: #161b22;
    padding: 0 2;
    margin-top: 1;
}

#inspector-panel.hidden {
    display: none;
}

#inspector-header {
    height: 2;
    color: #d2a8ff;
    text-style: bold;
}

#inspector-code {
    height: 1fr;
    background: #0d1117;
}

/* Admin Interactive Query Console & Seed Tab */
#admin-tabs {
    height: 1fr;
}

#console-container, #seed-container {
    height: 1fr;
    padding: 1 2;
}

#console-toolbar, #seed-controls-row {
    height: 4;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#seed-controls-row Input {
    width: 16;
    margin: 0 2;
}

#seed-controls-row Button {
    margin-left: 2;
}

#seed-progress-bar {
    margin-bottom: 1;
}

#seed-summary-status {
    height: 2;
    margin-bottom: 1;
}

#seed-log {
    height: 1fr;
    border: round #30363d;
    background: #0d1117;
}

#console-toolbar Label {
    margin-right: 1;
}

#console-engine-select {
    width: 36;
    margin-right: 2;
}

#console-editor {
    height: 10;
    border: round #58a6ff;
    margin-bottom: 1;
}

#console-status {
    height: 2;
    margin-bottom: 1;
}

#console-outputs {
    height: 1fr;
    layout: horizontal;
}

#console-table-box {
    width: 1fr;
    height: 1fr;
    border: round #30363d;
    background: #0d1117;
    padding: 0 1;
    margin-right: 1;
}

#console-results-table {
    height: 1fr;
}

#console-json-box {
    width: 1fr;
    height: 1fr;
    border: round #30363d;
    background: #161b22;
    padding: 0 1;
}

/* My Lists Tab */
#tab-lists {
    height: 1fr;
}

#lists-workspace {
    height: 1fr;
    layout: horizontal;
}

#lists-sidebar {
    width: 34;
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    padding: 1 1;
    margin-right: 1;
}

#my-lists-listview {
    height: 1fr;
    background: #0d1117;
    border: round #30363d;
}

#btn-lists-create {
    width: 100%;
    margin-top: 1;
}

#lists-detail-panel {
    width: 1fr;
    height: 1fr;
}

#lists-selected-heading {
    margin-bottom: 0;
}

#lists-selected-description {
    margin-bottom: 1;
}

#lists-detail-actions {
    height: 3;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

#lists-detail-actions Button {
    margin: 0 1;
}

/* ProfileView & ProfileScreen */
ProfileView {
    height: 1fr;
}

.profile-hero-card {
    height: auto;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
    align: center top;
}

.profile-avatar-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

#prof-avatar {
    width: 18;
    height: 11;
}

#prof-identity-banner {
    width: 100%;
    text-align: center;
    margin-bottom: 0;
}

#prof-joined-banner {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

.profile-follow-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

.profile-stats-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
}

.profile-stat-text {
    width: auto;
    height: 1;
    margin: 0 1;
    color: #e6edf3;
}

.profile-stat-link {
    width: auto;
    min-width: 1;
    height: 1;
    border: none;
    background: transparent;
    color: #79c0ff;
    padding: 0 1;
    margin: 0 1;
}

.profile-stat-link:hover {
    color: #58a6ff;
    text-style: underline;
    background: transparent;
}

.profile-actions-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: center middle;
}

.profile-actions-row Button {
    margin: 0 1;
}

#profile-subtabs {
    height: auto;
}

#profile-subtabs ContentSwitcher {
    height: auto;
}

#profile-subtabs TabPane {
    height: auto;
}

.profile-subtab-body {
    height: auto;
    padding: 1 0;
}

ProfileView MovieGrid,
ProfileView .movie-grid-scroll {
    height: auto;
}

.profile-empty-hint {
    padding: 1 2;
}

.review-card-header {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.review-movie-title-link {
    width: auto;
    min-width: 1;
    height: 1;
    border: none;
    background: transparent;
    color: #58a6ff;
    text-style: bold;
    padding: 0;
}

.review-movie-title-link:hover {
    color: #79c0ff;
    text-style: bold underline;
    background: transparent;
}

.review-card-meta {
    width: 1fr;
    height: 1;
}

.review-card-actions {
    width: 100%;
    height: 3;
    layout: horizontal;
    align: center middle;
}

.review-card-actions Button {
    min-width: 8;
    width: auto;
    padding: 0 1;
    margin: 0 1;
}

#follow-users-listview, #add-movie-results-listview {
    height: 12;
    border: round #30363d;
    background: #0d1117;
    margin: 1 0;
}

#wrapped-modal-card {
    border: double #d2a8ff;
}

#edit-profile-modal-card, #upload-avatar-modal-card, #create-list-modal-card, #visit-profile-modal-card, #search-reviews-modal-card {
    border: double #58a6ff;
}

#follow-list-modal-card {
    border: double #d2a8ff;
}

#confirm-modal-card {
    width: 56;
    border: double #f85149;
}

#confirm-modal-message {
    margin: 1 0;
}
